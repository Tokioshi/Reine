{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "reine",
    "main": "index.js",
    "compatibility_date": "2026-05-25",
    "workers_dev": true,
    "triggers": {
        "crons": ["*/10 * * * *"],
    },
    "vars": {
        "DISCORD_API_BASE": "https://discord.com/api/v10",
        "TICKET_ROLE_IDS": "1254702078555586592,1416280122767708201,1101865823188025354",
    },
    "secrets": {
        "required": [
            "BOT_TOKEN",
            "APPLICATION_ID",
            "PUBLIC_KEY",
            "GUILD_ID",
            "NOTIFY_CHANNEL_ID",
            "TICKET_LOG_CHANNEL_ID",
            "REGISTER_SECRET",
            "ANILIST_PROXY_TOKEN",
            "ANILIST_PROXY_URL",
        ],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "reine_db",
            "database_id": "01e25886-f408-4e55-b10e-0c56d6316c6c",
            "migrations_dir": "schema",
        },
    ],
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
}
